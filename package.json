{
  "name": "coketv",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "vite build",
    "test": "npm run test:core && npm run test:ui",
    "test:core": "node --test tests/*.test.js",
    "test:ui": "vitest run --config vitest.config.js",
    "check": "node scripts/check.mjs && node scripts/check-identifiers.mjs && node scripts/check-shell.mjs && node scripts/check-engine.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.5",
    "adm-zip": "^0.6.0",
    "axios": "^1.7.9",
    "basic-ftp": "^6.2.2",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.5",
    "iconv-lite": "^0.6.3",
    "json-bigint": "^1.0.0",
    "lru-cache": "^9.1.2",
    "node-sqlite3-wasm": "^0.8.35",
    "qrcode": "^1.5.4",
    "sync-fetch": "^0.6.0-2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@lucide/vue": "^1.51.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "artplayer": "^5.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.3",
    "jsdom": "^26.1.0",
    "monaco-editor": "^0.52.2",
    "mpegts.js": "^1.8.2",
    "node-forge": "^1.3.1",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "undici": "^6.21.1",
    "vite": "^6.0.0",
    "vitest": "^3.2.7",
    "vue": "^3.5.0",
    "vue-sonner": "^2.0.9"
  },
  "description": "CokeTV：基于 drpy3 的源执行与 TVBox / 猫影视 / Emby 订阅服务",
