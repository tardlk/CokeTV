HOST=0.0.0.0
PORT=54058
TZ=Asia/Shanghai

# 仅 Docker 入口使用；Compose 会读取并传入这两项。NAS 为1000:10时将PGID改为10。
# PUID=1000
# PGID=1000

# 留空时读取 data/admin.json；全新部署首次进入管理后台直接填写新密码和确认密码。
# 仅在尚未创建管理密码时生效，不覆盖已有密码；重启需继续提供此变量。
# 源码启动由 dotenv 读取本文件。Compose 不自动注入这些变量，需显式配置 environment。
ADMIN_PASSWORD=

# 按服务器实际安装位置配置；start.sh 会优先发现 .tools/ 下的本机工具。
# PYTHON_PATH=/absolute/path/to/.venv/bin/python3
# PHP_PATH=php
# CHROME_PATH=/usr/bin/chromium
# DATA_DIR=/absolute/path/to/coketv-data
# TRUST_PROXY=1

# 限流与鉴权失败预算（分钟窗口内，按来源 IP 计数）。
# 同一 NAT/反向代理后多观众看 HLS 可调大 RATE_LIMIT_PER_MINUTE；
# GET/HEAD 媒体转发携带有效且绑定当前 URL 的 proxy 票据时豁免；/proxy/ 源执行仍限流。
# TRUST_PROXY=1 时 request.ip 取自
# X-Forwarded-For，必须确保前置代理可信且会覆写该头，否则限流可被伪造 IP 绕过。
# RATE_LIMIT_PER_MINUTE=1200
# ADMIN_AUTH_FAIL_PER_MINUTE=20

# /http 非流式上游响应体上限（字节）。默认 16 MiB，合法范围 64 KiB–128 MiB，非法值回退默认。
# 只作用于 /http 这类非流式辅助调用；媒体播放走流式转发，不受该上限影响。
# HTTP_MAX_RESPONSE_BYTES=16777216
